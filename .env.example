# Copy to .env (and .env.test for `npm test`, pointing at a separate database).

PORT=4000
DATABASE_URL=postgres://localhost:5432/cocare
# Neon: `neon init` / `neon deploy` fill these in. DATABASE_URL is the pooled string (app queries),
# DATABASE_URL_UNPOOLED the direct one (migrations). Leave UNPOOLED unset for local Postgres.
# DATABASE_URL_UNPOOLED=
# Comma-separated list, or * for any origin (the API uses bearer tokens, not cookies).
CORS_ORIGINS=*
SESSION_DAYS=30
# How long a caregiver invite code works.
INVITE_DAYS=14

# Swagger UI at /docs and the OpenAPI document at /openapi.json (set false to hide them).
API_DOCS=true

# true = automatically post one in-app reminder ~1h after an activity's time if there's no report.
AUTO_NUDGE=false
