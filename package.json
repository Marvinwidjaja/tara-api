{
  "name": "cocare-backend",
  "version": "1.0.0",
  "private": true,
  "description": "TARA API: parent accounts, goals, activities, assignments, caregiver accounts and reports (Express + PostgreSQL).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/sync-shared.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prebuild": "node scripts/sync-shared.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:create": "createdb cocare && createdb cocare_test",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "pretest": "node scripts/sync-shared.mjs",
    "test": "NODE_ENV=test node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "sync-shared": "node scripts/sync-shared.mjs",
    "vercel-build": "node scripts/sync-shared.mjs && tsc --noEmit -p tsconfig.build.json && tsx src/db/migrate.ts --deploy"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@vercel/functions": "^3.11.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
